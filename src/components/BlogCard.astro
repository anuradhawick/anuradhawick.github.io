---
import { getRelativePath } from '../utils/paths';

interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  slug: string;
  tags?: string[];
  heroImage?: string;
}

const { title, description, pubDate, slug, tags = [], heroImage } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});

const postUrl = getRelativePath(`/blog/${slug}`);
const resolvedImage = heroImage ? getRelativePath(heroImage) : undefined;
---

<article class="group relative flex flex-col md:flex-row gap-5 p-5 rounded-xl border border-[var(--border-color)] bg-[var(--card-bg)] hover:border-[var(--accent-color)]/50 hover:shadow-md transition-all">
  {resolvedImage && (
    <div class="w-full md:w-44 h-32 shrink-0 rounded-lg overflow-hidden bg-[var(--bg-tertiary)]">
      <img src={resolvedImage} alt={title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
    </div>
  )}
  <div class="flex flex-col justify-between flex-1">
    <div>
      <div class="flex items-center gap-3 text-xs text-[var(--text-muted)] mb-1.5">
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        {tags.length > 0 && (
          <span class="inline-flex gap-1.5">
            {tags.slice(0, 2).map(tag => (
              <span class="px-2 py-0.5 rounded-full bg-[var(--bg-tertiary)] text-[var(--text-secondary)] font-medium text-[11px]">
                #{tag}
              </span>
            ))}
          </span>
        )}
      </div>
      <h3 class="text-lg font-bold text-[var(--text-primary)] group-hover:text-[var(--accent-color)] transition-colors">
        <a href={postUrl}>
          <span class="absolute inset-0"></span>
          {title}
        </a>
      </h3>
      {description && (
        <p class="text-sm text-[var(--text-secondary)] mt-1.5 line-clamp-2">
          {description}
        </p>
      )}
    </div>
    <div class="mt-3 text-xs font-semibold text-[var(--accent-color)] flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
      Read article &rarr;
    </div>
  </div>
</article>
