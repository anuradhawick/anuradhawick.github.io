---
import { getRelativePath } from '../utils/paths';

interface Props {
  title: string;
  description: string;
  image?: string;
  githubUrl?: string;
  liveUrl?: string;
  tags?: string[];
  featured?: boolean;
}

const { title, description, image, githubUrl, liveUrl, tags = [], featured = false } = Astro.props;

const resolvedImage = image ? getRelativePath(image) : undefined;
---

<div class={`flex flex-col justify-between p-6 rounded-xl border transition-all ${
  featured 
    ? 'border-[var(--accent-color)]/40 bg-[var(--card-bg)] shadow-sm' 
    : 'border-[var(--border-color)] bg-[var(--card-bg)] hover:border-[var(--accent-color)]/40'
}`}>
  <div>
    <div class="flex items-start gap-4 mb-4">
      {resolvedImage && (
        <img src={resolvedImage} alt={title} class="w-12 h-12 rounded-lg object-contain p-1 bg-[var(--bg-tertiary)] border border-[var(--border-color)]" loading="lazy" />
      )}
      <div>
        <h3 class="text-lg font-bold text-[var(--text-primary)]">{title}</h3>
        {tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5 mt-1">
            {tags.map(tag => (
              <span class="text-[11px] px-2 py-0.5 rounded-md bg-[var(--bg-tertiary)] text-[var(--text-secondary)] font-medium">
                {tag}
              </span>
            ))}
          </div>
        )}
      </div>
    </div>
    <p class="text-sm text-[var(--text-secondary)] leading-relaxed">{description}</p>
  </div>

  <div class="mt-5 pt-4 border-t border-[var(--border-color)] flex items-center gap-3 text-xs font-semibold">
    {githubUrl && (
      <a href={githubUrl} target="_blank" rel="noreferrer noopener" class="inline-flex items-center gap-1.5 text-[var(--accent-color)] hover:underline">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
        </svg>
        GitHub
      </a>
    )}
    {liveUrl && (
      <a href={liveUrl} target="_blank" rel="noreferrer noopener" class="inline-flex items-center gap-1 text-[var(--accent-color)] hover:underline ml-auto">
        Live Demo
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
        </svg>
      </a>
    )}
  </div>
</div>
