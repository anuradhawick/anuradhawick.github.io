---
import { getRelativePath } from '../utils/paths';

interface Props {
  title: string;
  description: string;
  image?: string;
  githubUrl?: string;
  liveUrl?: string;
  crateUrl?: string;
  pypiUrl?: string;
  condaUrl?: string;
  tags?: string[];
  featured?: boolean;
}

const {
  title,
  description,
  image,
  githubUrl,
  liveUrl,
  crateUrl,
  pypiUrl,
  condaUrl,
  tags = [],
  featured = false
} = Astro.props;

const resolvedImage = image ? getRelativePath(image) : undefined;
---

<div class={`flex flex-col justify-between p-6 rounded-xl border transition-all ${
  featured 
    ? 'border-(--accent-color)/40 bg-(--card-bg) shadow-sm' 
    : 'border-(--border-color) bg-(--card-bg) hover:border-(--accent-color)/40'
}`}>
  <div>
    <div class="flex items-start gap-4 mb-4">
      {resolvedImage && (
        <img src={resolvedImage} alt={title} class="w-12 h-12 rounded-lg object-contain p-1 bg-(--bg-tertiary) border border-(--border-color)" loading="lazy" />
      )}
      <div>
        <h3 class="text-lg font-bold text-(--text-primary)">{title}</h3>
        {tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5 mt-1">
            {tags.map(tag => (
              <span class="text-[11px] px-2 py-0.5 rounded-md bg-(--bg-tertiary) text-(--text-secondary) font-medium">
                {tag}
              </span>
            ))}
          </div>
        )}
      </div>
    </div>
    <p class="text-sm text-(--text-secondary) leading-relaxed">{description}</p>
  </div>

  <div class="mt-5 pt-4 border-t border-(--border-color) flex flex-wrap items-center gap-3 text-xs font-semibold">
    {githubUrl && (
      <a href={githubUrl} target="_blank" rel="noreferrer noopener" class="inline-flex items-center gap-1.5 text-(--accent-color) hover:underline">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
        </svg>
        GitHub
      </a>
    )}
    {crateUrl && (
      <a href={crateUrl} target="_blank" rel="noreferrer noopener" class="inline-flex items-center gap-1.5 text-amber-600 dark:text-amber-400 hover:underline">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
        </svg>
        crates.io
      </a>
    )}
    {pypiUrl && (
      <a href={pypiUrl} target="_blank" rel="noreferrer noopener" class="inline-flex items-center gap-1.5 text-sky-600 dark:text-sky-400 hover:underline">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
        </svg>
        PyPI
      </a>
    )}
    {condaUrl && (
      <a href={condaUrl} target="_blank" rel="noreferrer noopener" class="inline-flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400 hover:underline">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
        </svg>
        Bioconda
      </a>
    )}
    {liveUrl && (
      <a href={liveUrl} target="_blank" rel="noreferrer noopener" class="inline-flex items-center gap-1 text-(--accent-color) hover:underline ml-auto">
        Live Demo
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
        </svg>
      </a>
    )}
  </div>
</div>
