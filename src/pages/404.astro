---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getRelativePath } from '../utils/paths';
---

<BaseLayout title="Page Not Found (404)">
  <div class="text-center py-20 space-y-6">
    <div class="inline-block px-3 py-1 rounded-full text-sm font-semibold bg-rose-500/10 text-rose-600 dark:text-rose-400">
      404 Error
    </div>
    <h1 class="text-4xl sm:text-5xl font-extrabold text-[var(--text-primary)]">
      Page Not Found
    </h1>
    <p class="text-base text-[var(--text-secondary)] max-w-md mx-auto">
      The page you are looking for might have been moved, renamed, or no longer exists.
    </p>
    <div class="pt-4">
      <a href={getRelativePath('/')} class="px-5 py-2.5 rounded-lg bg-[var(--accent-color)] text-white text-sm font-semibold hover:opacity-90 transition-opacity">
        Return to Homepage &rarr;
      </a>
    </div>
  </div>
</BaseLayout>
