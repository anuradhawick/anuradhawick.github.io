---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => {
    const d = new Date(post.data.pubDate);
    const year = d.getUTCFullYear().toString();
    const month = String(d.getUTCMonth() + 1).padStart(2, '0');
    const day = String(d.getUTCDate()).padStart(2, '0');
    return {
      params: {
        year,
        month,
        day,
        slug: post.id,
      },
      props: {
        canonicalSlug: post.id,
        title: post.data.title,
      },
    };
  });
}

const { canonicalSlug, title } = Astro.props;
const targetUrl = `/blog/${canonicalSlug}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting to {title}...</title>
    <link rel="canonical" href={targetUrl} />
    <meta http-equiv="refresh" content={`0; url=${targetUrl}`} />
    <script is:inline define:vars={{ targetUrl }}>
      window.location.replace(targetUrl);
    </script>
  </head>
  <body class="p-10 text-center font-sans bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-100">
    <p>Redirecting to <a href={targetUrl} class="text-sky-600 underline">{title}</a>...</p>
  </body>
</html>
