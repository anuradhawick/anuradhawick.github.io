---
import { getRelativePath } from '../utils/paths';
const targetUrl = getRelativePath('/apps');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting to Software & Tools...</title>
    <link rel="canonical" href={targetUrl} />
    <meta http-equiv="refresh" content={`0; url=${targetUrl}`} />
    <script is:inline define:vars={{ targetUrl }}>
      window.location.replace(targetUrl);
    </script>
  </head>
  <body class="bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 p-10 text-center font-sans">
    <p>Redirecting to <a href={targetUrl} class="text-sky-600 underline">Software &amp; Tools</a>...</p>
  </body>
</html>
