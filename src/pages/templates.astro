---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getRelativePath } from '../utils/paths';
---

<BaseLayout
  title="Templates & Starters"
  description="Production-grade cloud, infrastructure, and serverless templates created by Anuradha Wickramarachchi."
>
  <div class="space-y-10">
    <div class="pb-6 border-b border-[var(--border-color)]">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[var(--text-primary)]">
        Templates &amp; Starters
      </h1>
      <p class="text-base sm:text-lg text-[var(--text-secondary)] mt-2">
        Reusable infrastructure-as-code blueprints and project templates to kickstart cloud and web deployments.
      </p>
    </div>

    <!-- Template 1: Rust AWS Lambda Template -->
    <div class="p-6 rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)] space-y-4">
      <div class="flex flex-col md:flex-row gap-6 items-start">
        <div class="w-full md:w-1/2 rounded-xl overflow-hidden border border-[var(--border-color)] bg-[var(--bg-tertiary)]">
          <img src={getRelativePath('/assets/uploads/image.png')} alt="Rust AWS Lambda Template" class="w-full h-auto object-cover" />
        </div>
        <div class="flex-1 space-y-3">
          <div class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
            Rust &middot; AWS Lambda &middot; Terraform
          </div>
          <h2 class="text-2xl font-bold text-[var(--text-primary)]">Rust AWS Lambda Template</h2>
          <p class="text-sm text-[var(--text-secondary)] leading-relaxed">
            This repository contains a Rust-based AWS Lambda function, managed using the <code>cargo-lambda</code> tool and deployed via Terraform. It provides an optimized starting point for deploying ultra-fast, cold-start-free serverless functions on AWS.
          </p>
          <div class="pt-2">
            <a
              href="https://github.com/anuradhawick/rs_template"
              target="_blank"
              rel="noreferrer noopener"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-[var(--accent-color)] text-white text-xs font-semibold hover:opacity-90 transition-opacity"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
              </svg>
              View on GitHub (rs_template)
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Template 2: Template Web Server -->
    <div class="p-6 rounded-2xl border border-[var(--border-color)] bg-[var(--card-bg)] space-y-4">
      <div class="flex flex-col md:flex-row gap-6 items-start">
        <div class="w-full md:w-1/2 rounded-xl overflow-hidden border border-[var(--border-color)] bg-[var(--bg-tertiary)]">
          <img src={getRelativePath('/assets/uploads/image-1.png')} alt="Template Web Server" class="w-full h-auto object-cover" />
        </div>
        <div class="flex-1 space-y-3">
          <div class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-sky-500/10 text-sky-600 dark:text-sky-400">
            Angular &middot; Python &middot; Docker &middot; AWS Terraform
          </div>
          <h2 class="text-2xl font-bold text-[var(--text-primary)]">Template Web Server</h2>
          <p class="text-sm text-[var(--text-secondary)] leading-relaxed">
            A comprehensive template for deploying web applications to AWS using Terraform. Includes an Angular web frontend and two starter backend Lambdas: one using pure Python, and another using Docker container images to deploy a Python microservice.
          </p>
          <div class="pt-2">
            <a
              href="https://github.com/anuradhawick/tf_template"
              target="_blank"
              rel="noreferrer noopener"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-[var(--accent-color)] text-white text-xs font-semibold hover:opacity-90 transition-opacity"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
              </svg>
              View on GitHub (tf_template)
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
